# Copy to .env.local for dev (or set in Vercel dashboard for prod).

# WebSocket base URL. Empty/unset = use current page's origin (works with the
# Vite dev proxy). In production set to the Fly.io backend, since Vercel
# cannot proxy WebSockets.
#
# Example for prod:
#   VITE_WS_BASE=wss://chatgame-backend.fly.dev
VITE_WS_BASE=
